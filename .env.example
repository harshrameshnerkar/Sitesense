# SiteSense Platform Environment Configuration

# Application
APP_NAME=SiteSense
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-super-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / Neon PostgreSQL)
# Local PostgreSQL default:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sitesense
# Neon Console Example (uncomment and replace when moving to Neon):
# DATABASE_URL=postgresql://neondb_owner:<password>@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# If PostgreSQL is not running locally during initial dev, fall back gracefully to SQLite:
DATABASE_FALLBACK_SQLITE=True

# Storage Paths
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
ANNOTATED_DIR=./storage/annotated
REPORT_DIR=./storage/reports

# LLM & Vision Model Settings
VISION_MODEL_NAME=google/owlvit-base-patch32
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# Optional External API Keys (e.g. Gemini / OpenAI for agent reasoning):
GEMINI_API_KEY=
OPENAI_API_KEY=

